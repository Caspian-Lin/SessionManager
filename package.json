{
  "name": "session-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Local AI conversation archive with polymorphic session adapters, same-provider deduplication, and integrity verification",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' run build",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' run typecheck",
    "test": "vitest run",
    "probe": "node tools/probe-formats.mjs",
    "sm": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
